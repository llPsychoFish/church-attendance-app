<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Service Type"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose the current service to continue"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServiceSun"
        style="@style/Widget.App.Button.Member"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="Sunday Service"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServiceWed"
        style="@style/Widget.App.Button.Member"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="Wednesday Service"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServiceFri"
        style="@style/Widget.App.Button.Member"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="Friday Service"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServiceCell"
        style="@style/Widget.App.Button.FirstTimer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cell Meeting"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

</LinearLayout>
