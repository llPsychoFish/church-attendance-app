<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application light theme -->
    <style name="Base.Theme.MyFirstTimer" parent="Theme.Material3.Light.NoActionBar">
        <!-- Material 3 Color Palette mapping -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/on_blue_container</item>

        <item name="colorSecondary">@color/color_accent_gold</item>
        <item name="colorOnSecondary">@color/text_on_gold</item>
        <item name="colorSecondaryContainer">@color/brand_gold_container</item>
        <item name="colorOnSecondaryContainer">@color/on_gold_container</item>

        <item name="colorTertiary">@color/color_primary_dark</item>

        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/white</item>

        <item name="colorOutline">@color/color_divider</item>

        <!-- Status bar styling -->
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global Text Transformations -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.MyFirstTimer" parent="Base.Theme.MyFirstTimer" />

    <!-- Splash / Landing screen: single landing that merges with the system splash.
         Background uses the theme window background so it adapts to Light/Dark.
         The animated icon is pngegg.png (shared with the launcher icon). -->
    <style name="Theme.MyFirstTimer.Splash" parent="Theme.MyFirstTimer">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">?android:attr/colorBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyFirstTimer</item>
    </style>

    <!-- Button Style: Routine Member Registration (Deep Blue) -->
    <style name="Widget.App.Button.Member" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Button Style: Warm First Timer Welcome Registration (Gold Accent) -->
    <style name="Widget.App.Button.FirstTimer" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/color_accent_gold</item>
        <item name="android:textColor">@color/text_on_gold</item>
        <item name="iconTint">@color/text_on_gold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>