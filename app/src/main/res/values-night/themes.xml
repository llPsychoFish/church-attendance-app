<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application dark theme -->
    <style name="Base.Theme.MyFirstTimer" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Material 3 Dark Color Palette mapping -->
        <item name="colorPrimary">@color/dark_color_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/dark_brand_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_blue_container</item>

        <item name="colorSecondary">@color/dark_color_accent_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/dark_brand_gold_container</item>
        <item name="colorOnSecondaryContainer">@color/dark_on_gold_container</item>

        <item name="colorTertiary">@color/dark_color_primary_dark</item>

        <item name="android:colorBackground">@color/dark_color_background</item>
        <item name="colorSurface">@color/dark_color_surface</item>
        <item name="colorSurfaceVariant">@color/dark_color_surface_variant</item>
        <item name="colorOnSurface">@color/dark_color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_color_text_secondary</item>

        <item name="colorError">@color/dark_color_error</item>
        <item name="colorOnError">@color/black</item>

        <item name="colorOutline">@color/dark_color_divider</item>

        <!-- Status bar styling -->
        <item name="android:statusBarColor">@color/dark_color_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global Text Transformations -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.MyFirstTimer" parent="Base.Theme.MyFirstTimer" />

    <!-- Button Style: Routine Member Registration (Dark Mode Blue) -->
    <style name="Widget.App.Button.Member" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/dark_color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Button Style: Warm First Timer Welcome Registration (Glowing Gold Accent) -->
    <style name="Widget.App.Button.FirstTimer" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/dark_color_accent_gold</item>
        <item name="android:textColor">@color/black</item>
        <item name="iconTint">@color/black</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>